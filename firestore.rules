rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 120 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 254)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1024)) &&
             (!('selectedWallpaperId' in data) || data.selectedWallpaperId == null || (data.selectedWallpaperId is string && data.selectedWallpaperId.size() >= 1 && data.selectedWallpaperId.size() <= 120)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCloudBookmark(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.url is string &&
             data.url.size() >= 1 &&
             data.url.size() <= 2048 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 300 &&
             data.folder is string &&
             data.folder.size() >= 1 &&
             data.folder.size() <= 100 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCloudFavorite(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 200 &&
             data.url is string &&
             data.url.size() >= 1 &&
             data.url.size() <= 2048 &&
             data.accentHex is int &&
             data.position is int &&
             data.position >= 0 &&
             data.position <= 10000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCloudReadingItem(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.url is string &&
             data.url.size() >= 1 &&
             data.url.size() <= 2048 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 300 &&
             data.excerpt is string &&
             data.excerpt.size() <= 2000 &&
             data.isRead is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'selectedWallpaperId', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       isValidUserProfile(incoming()) &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'selectedWallpaperId', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /bookmarks/{bookmarkId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(bookmarkId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(bookmarkId) &&
                         request.auth.uid == userId &&
                         isValidCloudBookmark(incoming()) &&
                         incoming().keys().hasAll(['userId', 'url', 'title', 'folder', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'url', 'title', 'folder', 'createdAt', 'updatedAt']);

        allow update: if isSignedIn() &&
                         isValidCloudBookmark(incoming()) &&
                         isValidId(userId) &&
                         isValidId(bookmarkId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['url', 'title', 'folder', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(bookmarkId) && request.auth.uid == userId;
      }

      match /favorites/{favoriteId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(favoriteId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(favoriteId) &&
                         request.auth.uid == userId &&
                         isValidCloudFavorite(incoming()) &&
                         incoming().keys().hasAll(['userId', 'title', 'url', 'accentHex', 'position', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'url', 'accentHex', 'position', 'createdAt', 'updatedAt']);

        allow update: if isSignedIn() &&
                         isValidCloudFavorite(incoming()) &&
                         isValidId(userId) &&
                         isValidId(favoriteId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'accentHex', 'position', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(favoriteId) && request.auth.uid == userId;
      }

      match /readingList/{itemId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(itemId) &&
                         request.auth.uid == userId &&
                         isValidCloudReadingItem(incoming()) &&
                         incoming().keys().hasAll(['userId', 'url', 'title', 'excerpt', 'isRead', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'url', 'title', 'excerpt', 'isRead', 'createdAt', 'updatedAt']);

        allow update: if isSignedIn() &&
                         isValidCloudReadingItem(incoming()) &&
                         isValidId(userId) &&
                         isValidId(itemId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['url', 'title', 'excerpt', 'isRead', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
      }
    }
  }
}
